# Django
DJANGO_SETTINGS_MODULE=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=

# Sentry (leave blank to disable - free tier: https://sentry.io)
SENTRY_DSN=

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Redis / Celery
# Both Celery URLs fall back to REDIS_URL, then to the Compose service.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Seconds a single scrape may run before Celery interrupts it (EXT-046).
# Beat's schedule itself is not configured here: it is derived from the
# Source rows in admin, so changing when a board is polled is an edit,
# not a redeploy.
CELERY_TASK_SOFT_TIME_LIMIT=
CELERY_TASK_TIME_LIMIT=

# How long publishing a task may wait on an unresponsive broker, in
# seconds (EXT-052). Blank uses the default of 5. Kept short: the caller
# is often a scrape run or an admin request, and a status change is
# already recorded before the follow-up task is queued.
CELERY_BROKER_CONNECT_TIMEOUT=
CELERY_BROKER_SOCKET_TIMEOUT=

# Caching
# Seconds a public read may be served from cache (default 60). A
# verification write invalidates immediately regardless.
PUBLIC_CACHE_TTL=

# Scraper politeness (EXT-041). Blank uses the defaults in settings.
SCRAPER_USER_AGENT=
SCRAPER_RATE_LIMIT_SECONDS=
SCRAPER_RATE_LIMIT_MAX_WAIT=
SCRAPER_MAX_ATTEMPTS=
SCRAPER_BACKOFF_BASE=
SCRAPER_TIMEOUT=
SCRAPER_ROBOTS_TTL=

# Source health (EXT-047). How many of a source's own scheduled runs may
# be missed before it is reported stale. Blank uses the default of 3.
SOURCE_STALE_AFTER_MISSED_RUNS=

# Observation matching (EXT-050). Blank uses the defaults in settings.
# Score at or above which an observation auto-links to an ExamStage
# (default 0.85); and how close two candidates may score before the
# choice is treated as a coin toss and sent to triage (default 0.05).
MATCH_AUTO_LINK_THRESHOLD=
MATCH_AMBIGUITY_MARGIN=

# Email and the daily verification digest (EXT-060).
# EMAIL_BACKEND defaults to the console backend, which prints the digest
# instead of sending it - fine for development, and it means a
# half-configured deployment is visible rather than silently failing.
# For real delivery use django.core.mail.backends.smtp.EmailBackend.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=

# When the digest goes out, in CELERY_TIMEZONE. Blank uses 07:00.
VERIFICATION_DIGEST_HOUR=
VERIFICATION_DIGEST_MINUTE=
# How many queue items the digest names individually (default 20).
VERIFICATION_DIGEST_MAX_ITEMS=

# Public base URL of the frontend, used for the console link in the
# digest. Blank omits the link rather than emitting a broken one.
FRONTEND_BASE_URL=

# Frontend
VITE_API_BASE_URL=
