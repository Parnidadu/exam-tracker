# Django
DJANGO_SETTINGS_MODULE=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=

# Sentry (leave blank to disable - free tier: https://sentry.io)
SENTRY_DSN=

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Redis / Celery
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Caching
# Seconds a public read may be served from cache (default 60). A
# verification write invalidates immediately regardless.
PUBLIC_CACHE_TTL=

# Frontend
VITE_API_BASE_URL=
