# Environment for a deployed instance. Copy to .env.prod or .env.staging.
#
# Staging and production use the SAME compose file and the SAME settings
# module; only the values below differ. That is deliberate - a staging
# environment configured differently rehearses something you are not
# about to do.
#
# What differs between the two, and nothing else:
#   SITE_ADDRESS, DJANGO_ALLOWED_HOSTS, the database name/credentials,
#   DJANGO_SECRET_KEY, SENTRY_DSN, and the HSTS values.

# Names this file, so `--env-file .env.staging` is self-consistent: the
# services load the same file compose substitutes variables from.
ENV_FILE=.env.prod

DJANGO_SETTINGS_MODULE=config.settings.prod
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# The public hostname, without a scheme. Staging: staging.exams.example.gov.in
DJANGO_ALLOWED_HOSTS=exams.example.gov.in

# The public address Caddy answers on, and how it gets a certificate.
# Production/staging: https://exams.example.gov.in  (leave TLS_DIRECTIVE
# blank so Caddy uses Let's Encrypt).
# Local rehearsal of the HTTPS path: https://localhost with
# TLS_DIRECTIVE="tls internal".
SITE_ADDRESS=https://exams.example.gov.in
TLS_DIRECTIVE=
ACME_EMAIL=ops@example.gov.in

# HSTS. Start at an hour; raise to 31536000 once you are confident.
# includeSubDomains and preload cannot be taken back quickly - a browser
# that has seen them will refuse plain HTTP for the whole max-age.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Only set these False to rehearse this configuration over plain HTTP.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Behind Caddy there is exactly one proxy. This is what makes the API
# throttle per-IP rather than per-header (EXT-062).
TRUSTED_PROXY_COUNT=1

SENTRY_DSN=

POSTGRES_DB=exam_tracker
POSTGRES_USER=exam_tracker
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Mail for the digest and alerts (EXT-060/061).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=exam-tracker@example.gov.in
FRONTEND_BASE_URL=https://exams.example.gov.in

BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
